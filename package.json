{
  "name": "willowforms",
  "private": true,
  "type": "module",
  "description": "An MIT-licensed visual form designer. The designer, not just the renderer.",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build && node scripts/copy-assets.mjs",
    "dev": "pnpm --filter playground dev",
    "dev:server": "pnpm --filter demo-server dev",
    "typecheck": "tsc --build --force && tsc -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "clean": "rimraf \"packages/*/dist\" \"apps/*/dist\" \"packages/*/*.tsbuildinfo\" \"apps/*/*.tsbuildinfo\" \"*.tsbuildinfo\"",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:dist": "playwright test --config playwright.dist.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelLeeHobbs/willowforms.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelLeeHobbs/willowforms/issues"
  },
  "homepage": "https://github.com/MichaelLeeHobbs/willowforms#readme"
}

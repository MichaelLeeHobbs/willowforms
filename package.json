{
  "name": "formsmith",
  "private": true,
  "type": "module",
  "description": "An MIT-licensed visual form designer. The designer, not just the renderer.",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build && node scripts/copy-assets.mjs",
    "dev": "pnpm --filter playground dev",
    "dev:server": "pnpm --filter demo-server dev",
    "typecheck": "tsc --build --force && tsc -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rimraf \"packages/*/dist\" \"apps/*/dist\" \"**/*.tsbuildinfo\"",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelLeeHobbs/formsmith.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelLeeHobbs/formsmith/issues"
  },
  "homepage": "https://github.com/MichaelLeeHobbs/formsmith#readme"
}

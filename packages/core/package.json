{
  "name": "@willowforms/core",
  "version": "0.0.0",
  "description": "Document model, kit registry contract, and tree operations for WillowForms. No UI dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf --glob dist *.tsbuildinfo"
  },
  "keywords": [
    "form",
    "form-builder",
    "form-designer",
    "react",
    "json-schema",
    "low-code",
    "drag-and-drop",
    "validation"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelLeeHobbs/willowforms.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/MichaelLeeHobbs/willowforms/issues"
  },
  "homepage": "https://github.com/MichaelLeeHobbs/willowforms/tree/main/packages/core#readme",
  "author": "Michael Hobbs",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "re2js": "^2.10.0"
  }
}

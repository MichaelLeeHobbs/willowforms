{
  "name": "@formsmith/designer",
  "version": "0.0.0",
  "description": "The visual form designer. MIT licensed, which is the entire point.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/designer.css"
  },
  "files": [
    "LICENSE",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@formsmith/core": "workspace:*",
    "@formsmith/renderer": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "form",
    "form-builder",
    "form-designer",
    "react",
    "json-schema",
    "low-code",
    "drag-and-drop",
    "visual-editor",
    "wysiwyg"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelLeeHobbs/formsmith.git",
    "directory": "packages/designer"
  },
  "bugs": {
    "url": "https://github.com/MichaelLeeHobbs/formsmith/issues"
  },
  "homepage": "https://github.com/MichaelLeeHobbs/formsmith/tree/main/packages/designer#readme",
  "author": "Michael Hobbs",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

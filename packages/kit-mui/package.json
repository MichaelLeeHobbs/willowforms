{
  "name": "@formsmith/kit-mui",
  "version": "0.0.0",
  "description": "Material UI component kit for Formsmith. The reference implementation of the kit contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@formsmith/core": "workspace:*",
    "@formsmith/renderer": "workspace:*"
  },
  "peerDependencies": {
    "@mui/material": "^6.0.0 || ^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "form",
    "form-builder",
    "form-designer",
    "react",
    "json-schema",
    "low-code",
    "drag-and-drop",
    "material-ui",
    "mui"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelLeeHobbs/formsmith.git",
    "directory": "packages/kit-mui"
  },
  "bugs": {
    "url": "https://github.com/MichaelLeeHobbs/formsmith/issues"
  },
  "homepage": "https://github.com/MichaelLeeHobbs/formsmith/tree/main/packages/kit-mui#readme",
  "author": "Michael Hobbs",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

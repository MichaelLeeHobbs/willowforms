{
  "name": "demo-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal persistence for the demo. Deliberately tiny: WillowForms is a frontend library.",
  "scripts": {
    "predev": "pnpm --filter @willowforms/core build",
    "dev": "node --watch src/index.ts",
    "prestart": "pnpm --filter @willowforms/core build",
    "start": "node src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@willowforms/core": "workspace:*",
    "hono": "^4.13.18"
  },
  "engines": {
    "node": ">=24"
  }
}

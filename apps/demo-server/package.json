{
  "name": "demo-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal persistence for the demo. Deliberately tiny: WillowForms is a frontend library.",
  "scripts": {
    "predev": "pnpm --filter @willowforms/core build",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "prestart": "pnpm --filter @willowforms/core build",
    "start": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@willowforms/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
